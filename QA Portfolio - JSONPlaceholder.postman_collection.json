          "name": "GET",
          "item": [
            {
              "name": "GET - Get all users",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const data = pm.response.json();\r",
                      "\r",
                      "pm.test(\"Status code is 200\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Response is JSON\", function() {\r",
                      "    pm.response.to.be.json;\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Response is an array\", function() {\r",
                      "    pm.expect(Array.isArray(data)).to.be.true;\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Users array is not empty\", function() {\r",
                      "    const data = pm.response.json();\r",
                      "    pm.expect(data.length).to.be.above(0);\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Each user has required fields\", function () {\r",
                      "    data.forEach(user => {\r",
                      "        pm.expect(user).to.have.property('id');\r",
                      "        pm.expect(user).to.have.property('name');\r",
                      "        pm.expect(user).to.have.property('email');\r",
                      "    });\r",
                      "});\r",
                      "\r",
                      "pm.test(\"User ID is numeric\", function () {\r",
                      "    data.forEach(user => {\r",
                      "        pm.expect(user.id).to.be.a('number');\r",
                      "    });\r",
                      "})\r",
                      "\r",
                      "pm.test(\"Email field contains @\", function () {\r",
                      "    data.forEach(user => {\r",
                      "        pm.expect(user.email).to.include('@');\r",
                      "        });\r",
                      "    });\r",
                      "    \r",
                      "pm.test(\"Response time is under 500ms\", function () {\r",
                      "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
